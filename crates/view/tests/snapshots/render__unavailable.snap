---
source: crates/view/tests/render.rs
expression: "portable(&r.html, empty.path())"
---
<div class="mv-screen">
<div class="mv-stack" data-gap="normal" data-block="main">
<section class="mv-card bv-card" data-block="snap" data-type="snapshot" data-state="partial">
<header class="mv-head">
<h2 class="mv-title">Snapshot</h2>
</header>
<div class="mv-tiles">
<div class="mv-tile" data-tone="neutral">
<span class="mv-tile-value mv-unavailable">unavailable</span>
<span class="mv-tile-label bv-meta">Needs you</span>
</div>
<div class="mv-tile" data-tone="neutral">
<span class="mv-tile-value mv-unavailable">unavailable</span>
<span class="mv-tile-label bv-meta">Open asks</span>
</div>
<div class="mv-tile" data-tone="neutral">
<span class="mv-tile-value mv-unavailable">unavailable</span>
<span class="mv-tile-label bv-meta">Running</span>
</div>
<div class="mv-tile" data-tone="neutral">
<span class="mv-tile-value mv-unavailable">unavailable</span>
<span class="mv-tile-label bv-meta">Stuck</span>
</div>
<div class="mv-tile" data-tone="neutral">
<span class="mv-tile-value mv-unavailable">unavailable</span>
<span class="mv-tile-label bv-meta">Loops drifting</span>
</div>
<div class="mv-tile" data-tone="neutral">
<span class="mv-tile-value mv-unavailable">unavailable</span>
<span class="mv-tile-label bv-meta">Live initiatives</span>
</div>
</div>
<p class="mv-note" data-tone="warning">5 sections read in part or not at all; counts are lower bounds or unavailable.</p>
</section>
<section class="mv-card bv-card" data-block="needs" data-type="needs" data-state="unavailable">
<header class="mv-head">
<h2 class="mv-title">Needs you</h2>
<span class="mv-count mv-unavailable">unavailable</span>
</header>
<p class="mv-note" data-tone="danger">Could not be read. This is not the same as none.</p>
<details class="mv-errors">
<summary data-tone="warning">2 sources could not be read</summary>
<ul>
<li>
<span class="bv-code">worktree:.broomva/asks</span>: No such file or directory (os error 2)</li>
<li>
<span class="bv-code">fs:<fixture>/work</span>: No such file or directory (os error 2)</li>
</ul>
</details>
<p class="mv-source bv-meta">
<span class="bv-code">worktree:.broomva/asks + fs:<fixture>/work</span>
</p>
</section>
