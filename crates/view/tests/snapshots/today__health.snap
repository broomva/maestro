---
source: crates/view/tests/today.rs
expression: "portable(&r.html, m.path())"
---
<div class="mv-screen">
<div class="mv-rail" data-block="s" data-type="health">
<section class="mv-card bv-card" data-block="health-plan" data-type="plan" data-state="ok">
<header class="mv-head">
<h2 class="mv-title">Plan</h2>
<span class="mv-count">1</span>
</header>
<div class="mv-plan" data-plan="2026-10-20-demo.graph.yaml">
<p class="mv-row-title">
<span class="bv-code">2026-10-20-demo.graph.yaml</span> · BRO-1 · 2 nodes</p>
<ul class="mv-plan-nodes">
<li class="mv-node bv-code" data-node="spec" title="">spec <span class="bv-meta">BRO-2</span>
</li>
<li class="mv-node bv-code" data-node="build" title="spec">build <span class="bv-meta">BRO-3</span>
</li>
</ul>
</div>
<p class="mv-note bv-meta" data-tone="warning">Node state is unavailable: it lives in Linear, which Maestro does not read yet.</p>
<p class="mv-source bv-meta">
<span class="bv-code">worktree:docs/plans</span>
</p>
</section>
<section class="mv-card bv-card" data-block="health-loops" data-type="heartbeats" data-state="ok">
<header class="mv-head">
<h2 class="mv-title">Loop heartbeats</h2>
<span class="mv-count">2</span>
</header>
<ul class="mv-list">
<li class="mv-row mv-beat" data-loop="demo-tick" data-beat="ok">
<span class="mv-beat-head">
<span class="mv-row-title bv-code">demo-tick</span>
<span class="mv-beat-state" data-tone="success">ok</span>
</span>
<span class="mv-beats" aria-label="last 4 ticks">
<span class="mv-beat-tick" data-outcome="ok" title="2026-10-01T00:00:00Z">
</span>
<span class="mv-beat-tick" data-outcome="open" title="2026-10-01T02:00:00Z">
</span>
<span class="mv-beat-tick" data-outcome="partial" title="2026-10-23T10:59:00Z">
</span>
<span class="mv-beat-tick" data-outcome="ok" title="2026-10-23T11:30:00Z">
</span>
</span>
</li>
<li class="mv-row mv-beat" data-loop="silent" data-beat="no receipts">
<span class="mv-beat-head">
<span class="mv-row-title bv-code">silent</span>
<span class="mv-beat-state" data-tone="danger">no receipts</span>
</span>
</li>
</ul>
<p class="mv-source bv-meta">
<span class="bv-code">worktree:.broomva/loops + fs:<fixture>/broomva-home/ledger/loops/ticks.jsonl</span>
</p>
</section>
<section class="mv-card bv-card" data-block="health-economy" data-type="economy" data-state="ok">
<header class="mv-head">
<h2 class="mv-title">Economy</h2>
</header>
<p class="mv-row-meta bv-meta">mode <span class="bv-code" data-mode="normal">normal</span>
</p>
<div class="mv-account" data-account="main">
<p class="mv-row-title">main · active</p>
<div class="mv-meter">
<span class="mv-meter-head">
<span class="bv-meta">5 h</span>
<span class="mv-meter-value">82%</span>
</span>
<span class="mv-meter-track">
<span class="mv-meter-fill" data-high="true" style="width: 82%">
</span>
</span>
</div>
<div class="mv-meter">
<span class="mv-meter-head">
<span class="bv-meta">7 d</span>
<span class="mv-meter-value">64%</span>
</span>
<span class="mv-meter-track">
<span class="mv-meter-fill" data-high="false" style="width: 64%">
</span>
</span>
</div>
</div>
<div class="mv-account" data-account="spare">
<p class="mv-row-title">spare</p>
<div class="mv-meter">
<span class="mv-meter-head">
<span class="bv-meta">5 h</span>
<span class="mv-meter-value">5%</span>
</span>
<span class="mv-meter-track">
<span class="mv-meter-fill" data-high="false" style="width: 5%">
</span>
</span>
</div>
<div class="mv-meter">
<span class="mv-meter-head">
<span class="bv-meta">7 d</span>
<span class="mv-meter-value">20%</span>
</span>
<span class="mv-meter-track">
<span class="mv-meter-fill" data-high="false" style="width: 20%">
</span>
</span>
</div>
</div>
<p class="mv-note bv-meta" data-gate="open">Launch gate: open · headroom (window_average)</p>
<p class="mv-source bv-meta">
<span class="bv-code">fs:<usage>
</span>
</p>
</section>
<section class="mv-card bv-card" data-block="health-receipts" data-type="receipts" data-state="ok">
<header class="mv-head">
<h2 class="mv-title">Receipts, last hour</h2>
<span class="mv-count">3</span>
</header>
<ul class="mv-list">
<li class="mv-row mv-receipt" data-receipt="ok">
<span class="mv-row-meta">
<span class="bv-code">11:40</span> <span class="mv-row-title">demo-tick tick ended</span> · ok</span>
<p class="mv-row-body">worked every</p>
</li>
<li class="mv-row mv-receipt" data-receipt="started">
<span class="mv-row-meta">
<span class="bv-code">11:30</span> <span class="mv-row-title">demo-tick tick started</span>
</span>
</li>
<li class="mv-row mv-receipt" data-receipt="partial">
<span class="mv-row-meta">
<span class="bv-code">11:05</span> <span class="mv-row-title">demo-tick tick ended</span> · partial</span>
<p class="mv-row-body">one tier skipped</p>
</li>
</ul>
<p class="mv-source bv-meta">
<span class="bv-code">fs:<fixture>/broomva-home/ledger/loops/ticks.jsonl</span>
</p>
</section>
</div>
<footer class="mv-foot bv-meta">Read from <span class="bv-code">worktree</span>
</footer>
</div>
